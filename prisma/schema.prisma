// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  MANAGER
  STAFF
}

enum CompetencyType {
  TECHNICAL
  BEHAVIORAL
}

enum RoleProfileStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CampaignScope {
  ORGANIZATION
  TEAM
  INDIVIDUAL
}

enum FrameworkStatus {
  DRAFT
  PUBLISHED
}

enum AssessmentStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  PENDING_CORROBORATION
  COMPLETED
}

enum TenantStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  CAMPAIGN_ASSIGNED
  ASSESSMENT_DUE_REMINDER
  ASSESSMENT_SUBMITTED_FOR_REVIEW
  CORROBORATION_OVERDUE
  CORROBORATION_COMPLETED
  ASSESSMENT_COMPLETED
  SYSTEM
}

enum NotificationEmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ------------------------------------------------------
// SUBSCRIPTION PLANS (PLATFORM LEVEL)
// ------------------------------------------------------

model SubscriptionPlan {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  defaultSeatLimit Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenants Tenant[]
}

// ------------------------------------------------------
// TENANT
// ------------------------------------------------------

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  status              TenantStatus @default(PENDING_ONBOARDING)
  planId              String?
  seatLimit           Int?
  isOnboarded         Boolean      @default(false)
  domain              String?
  primaryContactName  String?
  primaryContactEmail String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  plan               SubscriptionPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  users              User[]
  competencies       Competency[]
  roleProfiles       RoleProfile[]
  campaigns          AssessmentCampaign[]
  frameworkAdoptions TenantFrameworkAdoption[]
  invitations        TenantInvitation[]
  departments        Department[]
  teams              Team[]
  notifications      Notification[]

  @@index([planId])
}

// ------------------------------------------------------
// TENANT INVITATION
// ------------------------------------------------------

model TenantInvitation {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  name          String
  role          UserRole  @default(ORGANIZATION_ADMIN)
  managerId     String?
  roleProfileId String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  manager     User?        @relation("InvitationManager", fields: [managerId], references: [id], onDelete: SetNull)
  roleProfile RoleProfile? @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  teams       TenantInvitationTeam[]

  @@index([tenantId])
  @@index([email])
  @@index([tokenHash])
  @@index([managerId])
  @@index([roleProfileId])
}

// ------------------------------------------------------
// CANONICAL FRAMEWORK (PLATFORM LEVEL)
// ------------------------------------------------------

model FrameworkVersion {
  id          String          @id @default(cuid())
  version     String          @unique
  status      FrameworkStatus @default(DRAFT)
  description String?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  categories        FrameworkCategory[]
  adoptions         TenantFrameworkAdoption[]
  campaigns         AssessmentCampaign[]
  industryTemplates IndustryTemplate[]
}

model FrameworkCategory {
  id                 String         @id @default(cuid())
  frameworkVersionId String
  name               String
  description        String?
  type               CompetencyType
  parentId           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  frameworkVersion FrameworkVersion      @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)
  parent           FrameworkCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         FrameworkCategory[]   @relation("CategoryHierarchy")
  competencies     FrameworkCompetency[]

  @@index([frameworkVersionId])
  @@index([parentId])
}

model FrameworkCompetency {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category             FrameworkCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  levels               FrameworkLevel[]
  competencies         Competency[]
  templateCompetencies IndustryTemplateCompetency[]
  templateRequirements TemplateRequirement[]

  @@index([categoryId])
}

model FrameworkLevel {
  id                    String  @id @default(cuid())
  frameworkCompetencyId String
  level                 Int
  description           String
  evidencePrompt        String?

  frameworkCompetency FrameworkCompetency @relation(fields: [frameworkCompetencyId], references: [id], onDelete: Cascade)

  @@unique([frameworkCompetencyId, level])
}

// ------------------------------------------------------
// INDUSTRY TEMPLATES (PLATFORM LEVEL)
// ------------------------------------------------------

model IndustryTemplate {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  frameworkVersionId String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  frameworkVersion FrameworkVersion             @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  competencies     IndustryTemplateCompetency[]
  roleProfiles     TemplateRoleProfile[]

  @@index([frameworkVersionId])
}

model IndustryTemplateCompetency {
  id                    String   @id @default(cuid())
  industryTemplateId    String
  frameworkCompetencyId String
  createdAt             DateTime @default(now())

  industryTemplate    IndustryTemplate    @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
  frameworkCompetency FrameworkCompetency @relation(fields: [frameworkCompetencyId], references: [id], onDelete: Cascade)

  @@unique([industryTemplateId, frameworkCompetencyId])
  @@index([industryTemplateId])
  @@index([frameworkCompetencyId])
}

model TemplateRoleProfile {
  id                 String   @id @default(cuid())
  industryTemplateId String
  name               String
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  industryTemplate IndustryTemplate      @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
  requirements     TemplateRequirement[]

  @@index([industryTemplateId])
}

model TemplateRequirement {
  id                    String   @id @default(cuid())
  templateRoleProfileId String
  frameworkCompetencyId String
  targetLevel           Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  templateRoleProfile TemplateRoleProfile @relation(fields: [templateRoleProfileId], references: [id], onDelete: Cascade)
  frameworkCompetency FrameworkCompetency @relation(fields: [frameworkCompetencyId], references: [id], onDelete: Cascade)

  @@unique([templateRoleProfileId, frameworkCompetencyId])
  @@index([templateRoleProfileId])
  @@index([frameworkCompetencyId])
}

model TenantFrameworkAdoption {
  id                 String   @id @default(cuid())
  tenantId           String
  frameworkVersionId String
  adoptedAt          DateTime @default(now())
  isActive           Boolean  @default(true)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  frameworkVersion FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, frameworkVersionId])
  @@index([tenantId])
  @@index([frameworkVersionId])
}

// ------------------------------------------------------
// USER
// ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  tenantId      String?
  managerId     String?
  roleProfileId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Tenant relation (nullable for PLATFORM_ADMIN)
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleProfile RoleProfile? @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)

  // Self-relation: Manager and Direct Reports
  manager       User?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[] @relation("ManagerReports")

  campaignParticipations CampaignParticipant[]
  assessments            Assessment[]
  corroborations         Corroboration[]
  createdInvitations     TenantInvitation[]    @relation("InvitationCreator")
  managedInvitations     TenantInvitation[]    @relation("InvitationManager")
  teamMemberships        TeamMembership[]
  managedTeams           Team[]                @relation("TeamManager")
  notifications          Notification[]        @relation("UserNotifications")

  @@index([tenantId])
  @@index([managerId])
  @@index([roleProfileId])
}

// ------------------------------------------------------
// COMPETENCY & LEVELS
// ------------------------------------------------------

model Competency {
  id                    String               @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  type                  CompetencyType
  frameworkCompetencyId String?
  isCustom              Boolean              @default(true)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  frameworkCompetency  FrameworkCompetency?  @relation(fields: [frameworkCompetencyId], references: [id], onDelete: SetNull)
  levels               CompetencyLevel[]
  roleRequirements     RoleRequirement[]
  campaignCompetencies CampaignCompetency[]
  assessmentItems      AssessmentItem[]

  @@unique([tenantId, frameworkCompetencyId])
  @@index([tenantId])
  @@index([frameworkCompetencyId])
}

model CompetencyLevel {
  id             String  @id @default(cuid())
  competencyId   String
  level          Int
  description    String
  evidencePrompt String?

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([competencyId, level])
}

// ------------------------------------------------------
// ROLE PROFILE & REQUIREMENTS
// ------------------------------------------------------

model RoleProfile {
  id          String            @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      RoleProfileStatus @default(DRAFT)
  isArchived  Boolean           @default(false)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirements RoleRequirement[]
  campaigns    AssessmentCampaign[]
  users        User[]
  invitations  TenantInvitation[]

  @@index([tenantId])
}

model RoleRequirement {
  id            String @id @default(cuid())
  roleProfileId String
  competencyId  String
  targetLevel   Int

  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)
  competency  Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([roleProfileId, competencyId])
}

// ------------------------------------------------------
// ASSESSMENT CAMPAIGN
// ------------------------------------------------------

model AssessmentCampaign {
  id                    String            @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  roleProfileId         String?
  frameworkVersionId    String?
  deadline              DateTime
  requiresCorroboration Boolean           @default(false)
  status                CampaignStatus    @default(DRAFT)
  scope                 CampaignScope     @default(INDIVIDUAL)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleProfile      RoleProfile?          @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  frameworkVersion FrameworkVersion?     @relation(fields: [frameworkVersionId], references: [id], onDelete: SetNull)
  competencies     CampaignCompetency[]
  participants     CampaignParticipant[]
  campaignTeams    CampaignTeam[]
  assessments      Assessment[]

  @@index([tenantId])
  @@index([frameworkVersionId])
}

model CampaignCompetency {
  id           String @id @default(cuid())
  campaignId   String
  competencyId String

  campaign   AssessmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  competency Competency         @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([campaignId, competencyId])
}

model CampaignParticipant {
  id         String @id @default(cuid())
  campaignId String
  userId     String

  campaign AssessmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([campaignId, userId])
}

model CampaignTeam {
  id         String   @id @default(cuid())
  campaignId String
  teamId     String
  createdAt  DateTime @default(now())

  campaign AssessmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  team     Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([campaignId, teamId])
  @@index([campaignId])
  @@index([teamId])
}

// ------------------------------------------------------
// ASSESSMENT & CORROBORATION
// ------------------------------------------------------

model Assessment {
  id          String           @id @default(cuid())
  campaignId  String
  userId      String
  status      AssessmentStatus @default(NOT_STARTED)
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  campaign AssessmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    AssessmentItem[]

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
}

model AssessmentItem {
  id           String   @id @default(cuid())
  assessmentId String
  competencyId String
  selfRating   Int?
  evidenceText String?
  finalRating  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment    Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competency    Competency           @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  corroboration Corroboration?
  attachments   EvidenceAttachment[]

  @@unique([assessmentId, competencyId])
}

model EvidenceAttachment {
  id               String         @id @default(cuid())
  assessmentItemId String
  storagePath      String
  fileName         String
  mimeType         String
  fileSize         Int
  createdAt        DateTime       @default(now())

  assessmentItem   AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)

  @@index([assessmentItemId])
}

model Corroboration {
  id               String   @id @default(cuid())
  assessmentItemId String   @unique
  managerId        String
  rating           Int
  justification    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assessmentItem AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  manager        User           @relation(fields: [managerId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------
// ORGANIZATION STRUCTURE
// ------------------------------------------------------

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams  Team[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Team {
  id           String   @id @default(cuid())
  tenantId     String
  departmentId String?
  managerId    String?
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager         User?                @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  memberships     TeamMembership[]
  invitationTeams TenantInvitationTeam[]
  campaignTeams   CampaignTeam[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([departmentId])
  @@index([managerId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TenantInvitationTeam {
  id           String   @id @default(cuid())
  invitationId String
  teamId       String
  createdAt    DateTime @default(now())

  invitation TenantInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([invitationId, teamId])
  @@index([invitationId])
  @@index([teamId])
}

// ------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------

model Notification {
  id           String                  @id @default(cuid())
  tenantId     String?
  recipientId  String
  type         NotificationType
  title        String
  message      String
  href         String?
  resourceType String?
  resourceId   String?
  readAt       DateTime?
  emailStatus  NotificationEmailStatus @default(PENDING)
  emailSentAt  DateTime?
  emailError   String?
  dedupeKey    String?                 @unique
  createdAt    DateTime                @default(now())

  recipient User    @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([tenantId])
  @@index([createdAt])
}
