# ==============================================================================
# Skills Assessment Platform - Environment Variables Template
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (Direct or Pooled)
# Required in all environments.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skills_assessment_db?schema=public"

# Secret used to encrypt/sign authenticated session tokens (min 32 characters)
# Generate with: openssl rand -base64 32
# Required in all environments.
AUTH_SECRET="replace-with-a-long-random-secret"

# ------------------------------------------------------------------------------
# 2. EVIDENCE STORAGE - SUPABASE (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# In development/test, missing Supabase credentials safely fall back to local
# filesystem storage in .storage/ (strictly prohibited in production).
# In production, these three variables are strictly enforced at runtime.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_EVIDENCE_BUCKET="assessment-evidence"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL - RESEND (OPTIONAL IN DEV / REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# In development/test, missing RESEND_API_KEY activates the MockEmailClient.
# In production, RESEND_API_KEY and EMAIL_FROM are required for email dispatch.
RESEND_API_KEY="re_123456789_placeholder"
EMAIL_FROM="Skills Assessment Platform <notifications@skills.example.com>"

# ------------------------------------------------------------------------------
# 4. BACKGROUND CRON & REMINDER ENGINE (REQUIRED FOR CRON ENDPOINTS)
# ------------------------------------------------------------------------------
# Secret token passed via 'Authorization: Bearer <CRON_SECRET>' for /api/cron/*
CRON_SECRET="replace-with-a-secure-cron-secret"

# Optional cadence overrides for reminder schedules (defaults shown)
ASSESSMENT_REMINDER_DAYS="3,1"
CORROBORATION_OVERDUE_BUSINESS_DAYS="5"
