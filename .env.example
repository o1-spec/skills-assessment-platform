# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skills_assessment_db?schema=public"

# Authentication Session Secret (use openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"

# Supabase Storage Configuration (Server-side only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_EVIDENCE_BUCKET="assessment-evidence"

# Email Provider Configuration (Server-side only)
EMAIL_FROM="Skills Assessment Platform <notifications@skills.example.com>"
RESEND_API_KEY="re_123456789_placeholder"

# Cron Endpoint Authentication (Server-side only)
CRON_SECRET="replace-with-a-secure-cron-secret"

# Automated Reminders Configuration Defaults
ASSESSMENT_REMINDER_DAYS="3,1"
CORROBORATION_OVERDUE_BUSINESS_DAYS="5"
